{
  "name": "@vaultcompass/intent-guard-skill",
  "version": "1.2.1",
  "type": "module",
  "description": "Superpowers-compatible Intent Guard skills and helper CLIs",
  "license": "MIT",
  "keywords": [
    "intent-guard",
    "superpowers",
    "skills",
    "ai",
    "cursor"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/vaultcompasshq/intent-guard.git",
    "directory": "packages/skill"
  },
  "bugs": {
    "url": "https://github.com/vaultcompasshq/intent-guard/issues"
  },
  "homepage": "https://github.com/vaultcompasshq/intent-guard#readme",
  "publishConfig": {
    "access": "public",
    "tag": "latest"
  },
  "bin": {
    "intent-guard-coach": "./dist/coach-cli.js",
    "intent-guard-drift": "./dist/drift-cli.js",
    "intent-guard-extract": "./dist/extract-cli.js",
    "intent-guard-import-spec": "./dist/import-spec-cli.js",
    "intent-guard-freeze": "./dist/freeze-cli.js",
    "intent-guard-init": "./dist/init-cli.js",
    "intent-guard-index": "./dist/index-cli.js",
    "intent-guard-check": "./dist/check-cli.js",
    "intent-guard-correct": "./dist/correct-cli.js",
    "intent-guard-brief": "./dist/brief-cli.js",
    "intent-guard-doctor": "./dist/doctor-cli.js",
    "intent-guard-hook": "./dist/hook-cli.js",
    "intent-guard-report": "./dist/report-cli.js",
    "intent-guard-rules": "./dist/rules-cli.js",
    "intent-guard-pivot": "./dist/pivot-cli.js",
    "intent-guard-resume": "./dist/resume-cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "intent-contract",
    "prompt-coach",
    "drift-guard",
    "capture-correction"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@vaultcompass/intent-guard-core": "workspace:*",
    "@vaultcompass/intent-guard-schema": "workspace:*",
    "yaml": "^2.8.0"
