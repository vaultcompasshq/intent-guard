name: Intent Guard Drift

# Post-publish sample: installs @vaultcompass/intent-guard@latest from npm.

on:
  pull_request:

jobs:
  intent-guard-drift:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install Intent Guard
        run: pnpm dlx @vaultcompass/intent-guard@latest --version

      - name: Collect changed paths
        id: changed
        shell: bash
        run: |
          git fetch origin "${{ github.base_ref }}" --depth=1
          paths="$(git -c core.quotePath=false diff --name-only "origin/${{ github.base_ref }}...HEAD" | paste -sd, -)"
          echo "paths=${paths}" >> "$GITHUB_OUTPUT"

      # `check` is the full gate: it scores drift AND enforces the contract's
      # change budget (allowed/protected paths, max files, dependency guard),
      # matching what the pre-commit hook runs. `drift` is score-only and does
      # not enforce the budget, so use `check` in CI.
      # Add `--no-require-frozen` if the branch may not carry a frozen contract.
      - name: Check intent + budget
        run: |
          pnpm dlx @vaultcompass/intent-guard@latest check \
            --project . \
            --paths "${{ steps.changed.outputs.paths }}"
