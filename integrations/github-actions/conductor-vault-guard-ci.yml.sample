name: Conductor and Vault Guard

# Post-publish sample: this workflow assumes
# @vaultcompass/conductor-cli@latest is available on npm.
# vault-guard is installed from its published npm package.

on:
  pull_request:

jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install Conductor
        run: pnpm dlx @vaultcompass/conductor-cli@latest --version

      - name: Collect changed paths
        id: changed
        shell: bash
        run: |
          git fetch origin "${{ github.base_ref }}" --depth=1
          paths="$(git -c core.quotePath=false diff --name-only "origin/${{ github.base_ref }}...HEAD" | paste -sd, -)"
          echo "paths=${paths}" >> "$GITHUB_OUTPUT"

      # `check` runs the full gate (drift + change-budget enforcement), matching
      # the pre-commit hook. `drift` is score-only and skips the budget.
      - name: Check intent + budget
        run: |
          pnpm dlx @vaultcompass/conductor-cli@latest check \
            --project . \
            --paths "${{ steps.changed.outputs.paths }}"

      - name: Check secrets
        run: npx --yes @vaultcompass/vault-guard@latest -- scan . --format text
