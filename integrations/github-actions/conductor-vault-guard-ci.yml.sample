name: Intent Guard and Vault Guard

# Post-publish sample: this workflow assumes
# @vaultcompass/intent-guard@latest is available on npm.
# vault-guard is installed from its published npm package.

on:
  pull_request:

permissions:
  contents: read

jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install Intent Guard
        run: pnpm dlx @vaultcompass/intent-guard@latest --version

      # `check` runs the full gate (drift + change-budget enforcement), matching
      # the pre-commit hook. `drift` is score-only and skips the budget.
      #
      # --base makes the gate list the pull request's changes itself, reading
      # git NUL-separated, so every file name reaches the budget exactly as it
      # is. An unknown ref or a missing merge base exits 2 rather than judging
      # an empty list. github.base_ref is passed through env and read as a
      # shell variable, never as ${{ }} inside the run body, so a branch named
      # with a $(...) or backtick payload is data, not code, when bash sees it.
      - name: Check intent + budget
        shell: bash
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          git fetch origin "$BASE_REF"
          pnpm dlx @vaultcompass/intent-guard@latest check \
            --project . \
            --base "origin/$BASE_REF"

      - name: Check secrets
        run: npx --yes @vaultcompass/vault-guard@latest -- scan . --format text
