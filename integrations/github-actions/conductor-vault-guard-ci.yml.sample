name: Intent Guard and Vault Guard

# Post-publish sample: this workflow assumes
# @vaultcompass/intent-guard@latest is available on npm.
# vault-guard is installed from its published npm package.

on:
  pull_request:

permissions:
  contents: read

jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - uses: pnpm/action-setup@v4
        with:
          version: 10

      - uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: pnpm

      - name: Install Intent Guard
        run: pnpm dlx @vaultcompass/intent-guard@latest --version

      - name: Collect changed paths
        id: changed
        shell: bash
        # github.base_ref is attacker-influenced only in name, but a step
        # output built from file names is not: pass both through env and read
        # them as shell variables, never as ${{ }} inside the run body, so a
        # branch or file named with a $(...) or backtick payload is data, not
        # code, when bash sees it.
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          git fetch origin "$BASE_REF" --depth=1
          paths="$(git -c core.quotePath=false diff --name-only "origin/$BASE_REF...HEAD" | paste -sd, -)"
          echo "paths=${paths}" >> "$GITHUB_OUTPUT"

      # `check` runs the full gate (drift + change-budget enforcement), matching
      # the pre-commit hook. `drift` is score-only and skips the budget.
      - name: Check intent + budget
        shell: bash
        env:
          CHANGED: ${{ steps.changed.outputs.paths }}
        # An empty diff leaves CHANGED empty. From 1.5.2 the gate reads
        # `--paths ""` as the empty set and runs normally; 1.5.1 refused it
        # and turned an empty diff into a red check. Running without the flag
        # says the same thing here and works on every released version, the
        # way the Stop hook already does, so the branch stays.
        run: |
          if [[ -n "$CHANGED" ]]; then
            pnpm dlx @vaultcompass/intent-guard@latest check \
              --project . \
              --paths "$CHANGED"
          else
            pnpm dlx @vaultcompass/intent-guard@latest check --project .
          fi

      - name: Check secrets
        run: npx --yes @vaultcompass/vault-guard@latest -- scan . --format text
