name: Intent Guard and Vault Guard

# Post-publish sample: installs exact released versions of
# @vaultcompass/intent-guard and @vaultcompass/vault-guard from npm. Pin an
# exact version rather than @latest, so the gate that judges a pull request
# changes only when this file does. Prefer the composite action
# (vaultcompasshq/intent-guard@v1.10.3) where it fits; see README.md here.

on:
  pull_request:

permissions:
  contents: read

jobs:
  guardrails:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0 # v7.0.0
        with:
          fetch-depth: 0

      - uses: actions/setup-node@949feb2413d6458794dcd2491c4babbbce0c15c1 # v7.1.0
        with:
          node-version: 22

      # Both gates are installed outside the checkout, never with npx or pnpm
      # dlx from inside it: run from the checkout, npm reads a .npmrc the pull
      # request committed (which can repoint the registry), and npx runs a
      # copy out of the node_modules the pull request carries. Then the branch
      # being judged chooses its own judge. --ignore-scripts keeps any install
      # script from running.
      - name: Install Intent Guard and Vault Guard
        working-directory: ${{ runner.temp }}
        run: |
          npm install -g --ignore-scripts --prefix "$RUNNER_TEMP/ig" @vaultcompass/intent-guard@1.10.3
          npm install -g --ignore-scripts --prefix "$RUNNER_TEMP/vg" @vaultcompass/vault-guard@1.12.1

      # `check` runs the full gate (drift + change-budget enforcement), matching
      # the pre-commit hook. `drift` is score-only and skips the budget.
      #
      # --base makes the gate list the pull request's changes itself, reading
      # git NUL-separated, so every file name reaches the budget exactly as it
      # is. An unknown ref or a missing merge base exits 2 rather than judging
      # an empty list.
      #
      # --trust-base makes the gate read its rules (the contract, config.yaml
      # and the contracts archive) from the base branch instead of from the
      # branch it is judging. Without it a pull request can loosen its own
      # contract in the same commit that breaks it and pass. Keep both flags.
      #
      # github.base_ref is passed through env and read as a shell variable,
      # never as ${{ }} inside the run body, so a branch named with a $(...)
      # or backtick payload is data, not code, when bash sees it. Each binary
      # is called by absolute path, not looked up on PATH.
      - name: Check intent + budget
        shell: bash
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          git fetch origin "$BASE_REF"
          "$RUNNER_TEMP/ig/bin/intent-guard" check \
            --project . \
            --base "origin/$BASE_REF" \
            --trust-base "origin/$BASE_REF"

      # --trust-base reads .vault-guard.json from the base branch too, so a
      # pull request cannot add an allowlist entry that silences its own leak.
      - name: Check secrets
        shell: bash
        env:
          BASE_REF: ${{ github.base_ref }}
        run: |
          "$RUNNER_TEMP/vg/bin/vault-guard" scan . --format text --trust-base "origin/$BASE_REF"
